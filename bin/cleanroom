#!/bin/sh
set -eu

resolve_self() {
  source=$1
  while [ -L "$source" ]; do
    source_dir=$(CDPATH= cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)
    link=$(readlink "$source")
    case "$link" in
      /*) source=$link ;;
      *) source=$source_dir/$link ;;
    esac
  done
  CDPATH= cd -P "$(dirname "$source")" >/dev/null 2>&1 && printf '%s/%s\n' "$(pwd)" "$(basename "$source")"
}

SELF=$(resolve_self "$0")
ROOT=$(CDPATH= cd -P "$(dirname "$SELF")/.." >/dev/null 2>&1 && pwd)
IMAGE=${CLEANROOM_IMAGE:-cleanroom:local}

usage() {
  cat <<'EOF'
Usage:
  cleanroom --name NAME  Open Bash with separate work and state for this name
  cleanroom --name NAME --env-file FILE  Use a local env file for credentials
  cleanroom build    Build or refresh the Cleanroom image
  cleanroom install  Install the cleanroom command in ~/.local/bin
  cleanroom --help   Show this help

A name is required to launch. Reuse it to resume the same work and state.
The current directory is read-only at /context. Write to /workspace or /data.
Files are saved under ${XDG_DATA_HOME:-$HOME/.local/share}/cleanroom/NAME;
caches are under ${XDG_CACHE_HOME:-$HOME/.cache}/cleanroom/NAME.
Spaces and dashes become underscores; other special characters are removed.
Set CLEANROOM_IMAGE to override the Docker image tag.
By default, cleanroom uses .env in the current directory when it exists.
OPENROUTER_API_KEY in the shell takes precedence over the env file.
EOF
}

install_cli() {
  install_dir=${CLEANROOM_BIN_DIR:-$HOME/.local/bin}
  destination=$install_dir/cleanroom
  mkdir -p "$install_dir"
  if [ -L "$destination" ]; then
    existing=$(readlink "$destination")
    if [ "$existing" = "$SELF" ]; then
      echo "cleanroom is already installed at $destination"
      return
    fi
    echo "Refusing to replace existing symlink: $destination -> $existing" >&2
    exit 1
  elif [ -e "$destination" ]; then
    echo "Refusing to replace existing file: $destination" >&2
    exit 1
  fi
  ln -s "$SELF" "$destination"
  echo "Installed cleanroom at $destination"
  case ":${PATH:-}:" in
    *":$install_dir:"*) ;;
    *) echo "Add $install_dir to PATH to run 'cleanroom' by name." ;;
  esac
}

build_image() {
  docker build --tag "$IMAGE" "$ROOT"
}

case "${1:-}" in
  install)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    install_cli
    exit 0
    ;;
  build)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    docker info >/dev/null 2>&1 || {
      echo "Docker is not running. Start Docker Desktop and retry." >&2
      exit 1
    }
    build_image
    exit 0
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  --env-file|--env-file=*|--name|--name=*) ;;
  "") ;;
  *)
    usage >&2
    exit 2
    ;;
esac

context=$(pwd -P)
name=
env_file=${CLEANROOM_ENV_FILE:-}
if [ -z "$env_file" ] && [ -f "$context/.env" ]; then
  env_file=$context/.env
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      if [ "$#" -lt 2 ] || [ -z "$2" ]; then
        echo "--name requires a name." >&2
        exit 2
      fi
      name=$2
      shift 2
      ;;
    --name=*)
      name=${1#--name=}
      [ -n "$name" ] || { echo "--name requires a name." >&2; exit 2; }
      shift
      ;;
    --env-file)
      if [ "$#" -lt 2 ] || [ -z "$2" ]; then
        echo "--env-file requires a path." >&2
        exit 2
      fi
      env_file=$2
      shift 2
      ;;
    --env-file=*)
      env_file=${1#--env-file=}
      [ -n "$env_file" ] || { echo "--env-file requires a path." >&2; exit 2; }
      shift
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

if [ -n "$env_file" ] && { [ ! -f "$env_file" ] || [ ! -r "$env_file" ]; }; then
  echo "Cannot read env file: $env_file" >&2
  exit 1
fi

if [ -z "$name" ]; then
  echo "--name is required. Reuse a name to resume its saved state." >&2
  exit 2
fi
normalized_name=$(printf '%s' "$name" | LC_ALL=C tr '[:space:]-' '_' | LC_ALL=C tr -cd 'A-Za-z0-9_')
if [ -z "$normalized_name" ]; then
  echo "The name is empty after removing special characters." >&2
  exit 2
fi
if [ "$name" != "$normalized_name" ]; then
  printf 'Using cleanroom name: %s\n' "$normalized_name" >&2
fi
name=$normalized_name

docker info >/dev/null 2>&1 || {
  echo "Docker is not running. Start Docker Desktop and retry." >&2
  exit 1
}

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Building $IMAGE on first use..." >&2
  build_image
fi

data_root=${XDG_DATA_HOME:-$HOME/.local/share}/cleanroom
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/cleanroom
case "$data_root:$cache_root" in
  /*:/*) ;;
  *) echo "XDG data and cache directories must be absolute paths." >&2; exit 2 ;;
esac
(umask 077; mkdir -p "$data_root" "$cache_root")
data_root=$(CDPATH= cd -P "$data_root" && pwd)
cache_root=$(CDPATH= cd -P "$cache_root" && pwd)
if [ "$context" = / ]; then
  echo "The filesystem root would expose Cleanroom storage. Choose a separate context directory." >&2
  exit 2
fi
case "$data_root/" in
  "$cache_root/"*)
    echo "Cleanroom data and cache directories must not overlap." >&2
    exit 2
    ;;
esac
case "$cache_root/" in
  "$data_root/"*)
    echo "Cleanroom data and cache directories must not overlap." >&2
    exit 2
    ;;
esac
for storage_root in "$data_root" "$cache_root"; do
  case "$storage_root/" in
    "$context/"*)
      echo "The current directory would expose Cleanroom storage. Choose a separate context directory." >&2
      exit 2
      ;;
  esac
  case "$context/" in
    "$storage_root/"*)
      echo "Cleanroom storage cannot be used as the context directory." >&2
      exit 2
      ;;
  esac
done
session=$data_root/$name
cache=$cache_root/$name
for directory in "$session" "$cache"; do
  if [ -L "$directory" ]; then
    echo "Refusing a symlink for named Cleanroom storage." >&2
    exit 2
  fi
done
(umask 077; mkdir -p "$session")
chmod 700 "$session"

prepare_directory() {
  destination=$1
  legacy_volume=${2:-}
  if [ -L "$destination" ]; then
    echo "Refusing a symlink for named Cleanroom storage." >&2
    exit 2
  fi
  if [ -d "$destination" ]; then
    return
  fi
  if [ -n "$legacy_volume" ] && docker volume inspect "$legacy_volume" >/dev/null 2>&1; then
    temporary=$(mktemp -d "$(dirname "$destination")/.cleanroom-import.XXXXXX")
    if ! docker run --rm --network none --entrypoint sh \
      --mount "type=volume,source=$legacy_volume,target=/source,readonly" \
      --mount "type=bind,source=$temporary,target=/destination" \
      "$IMAGE" -c 'cp -a /source/. /destination/'; then
      rm -rf "$temporary"
      echo "Could not import saved Cleanroom state; the original volume is untouched." >&2
      exit 1
    fi
    chmod 700 "$temporary"
    mv "$temporary" "$destination"
  else
    (umask 077; mkdir -p "$destination")
  fi
}

prepare_directory "$session/workspace"
prepare_directory "$session/data"
prepare_directory "$session/share" "cleanroom-cli-seat-$name-opencode-data"
prepare_directory "$session/state" "cleanroom-cli-seat-$name-opencode-state"
prepare_directory "$cache" "cleanroom-cli-seat-$name-cache"
prepare_directory "$session/gems"
prepare_directory "$session/herdr"
printf 'Cleanroom files: %s\n' "$session" >&2
printf '%s\n' 'Context is read-only at /context; save work in /workspace or /data.' >&2

set -- docker run --rm --init --interactive \
  --workdir /workspace \
  --mount "type=bind,source=$context,target=/context,readonly" \
  --mount "type=bind,source=$session/workspace,target=/workspace" \
  --mount "type=bind,source=$session/data,target=/data" \
  --mount "type=volume,source=cleanroom-cli-opencode-config,target=/home/dev/.config/opencode" \
  --mount "type=bind,source=$session/share,target=/home/dev/.local/share" \
  --mount "type=bind,source=$session/state,target=/home/dev/.local/state" \
  --mount "type=bind,source=$cache,target=/home/dev/.cache" \
  --mount "type=bind,source=$session/gems,target=/home/dev/bundle" \
  --mount "type=bind,source=$session/herdr,target=/home/dev/.config/herdr"

if [ -t 0 ] && [ -t 1 ]; then
  set -- "$@" --tty
fi

if [ -n "$env_file" ]; then
  set -- "$@" --env-file "$env_file"
fi

# Hide credential files covered by the context bind mount.
if [ -f "$context/.env" ]; then
  set -- "$@" --mount "type=bind,source=/dev/null,target=/context/.env,readonly"
fi
if [ -n "$env_file" ]; then
  env_dir=$(CDPATH= cd -P "$(dirname "$env_file")" >/dev/null 2>&1 && pwd)
  env_path=$env_dir/$(basename "$env_file")
  case "$env_path" in
    "$context"/*)
      if [ "$env_path" != "$context/.env" ]; then
        set -- "$@" --mount "type=bind,source=/dev/null,target=/context/${env_path#"$context"/},readonly"
      fi
      ;;
  esac
fi
if [ -n "${OPENROUTER_API_KEY:-}" ]; then
  set -- "$@" --env OPENROUTER_API_KEY
fi
set -- "$@" --env XDG_DATA_HOME=/home/dev/.local/share \
  --env XDG_STATE_HOME=/home/dev/.local/state --env XDG_CACHE_HOME=/home/dev/.cache

exec "$@" "$IMAGE" bash
