#!/usr/bin/env python3
"""Verify Mac Brave can load a container-served page without touching existing tabs."""
import json
import os
from pathlib import Path
import subprocess
import time

root = Path(__file__).resolve().parent.parent
pid = None

def run(args, **kwargs):
    return subprocess.check_output(args, cwd=root, text=True, **kwargs)

subprocess.run(["docker", "compose", "up", "-d", "dev"], cwd=root, check=True, stdout=subprocess.DEVNULL)
cid = run(["docker", "compose", "ps", "-q", "dev"]).strip()

def browser(*args):
    return json.loads(run(["docker", "exec", cid, "node", "/opt/browser/cdp.mjs", *args]))

server = "require('http').createServer((q,r)=>{r.setHeader('Content-Type','text/html');r.end('<title>Cleanroom QA</title><h1>Container browser test passed</h1>')}).listen(3000,'0.0.0.0')"
try:
    pid = run(["docker", "exec", "-e", f"QASERVER={server}", cid,
               "sh", "-c", "node -e \"$QASERVER\" >/tmp/qa-server.log 2>&1 & echo $!"]).strip()
    for _ in range(30):
        ready = subprocess.run(["docker", "exec", cid, "node", "-e", "fetch('http://127.0.0.1:3000').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if ready.returncode == 0:
            break
        time.sleep(0.2)
    else:
        raise RuntimeError("QA server did not become ready")
    before = browser("status")["pages"]
    # The page opens in Mac Brave, so localhost is the Mac's published port.
    port = 13000
    for line in (root / ".env").read_text().splitlines():
        if line.startswith("RAILS_HOST_PORT=") and line.split("=", 1)[1].strip():
            port = int(line.split("=", 1)[1].strip())
    port = int(os.environ.get("RAILS_HOST_PORT", port))
    page = browser("open", "http://127.0.0.1:" + str(port))
    target = page["targetId"]
    try:
        assert page["title"] == "Cleanroom QA", page
        assert "Container browser test passed" in browser("inspect", target)["text"]
        assert browser("eval", target, "document.querySelector('h1').textContent") == "Container browser test passed"
        browser("screenshot", target, "/workspace/tmp/browser-smoke.png")
    finally:
        browser("close", target)
    assert browser("status")["pages"] == before, "Browser tab count changed unexpectedly"
    print("PASS: Brave loaded the container page; assertions and screenshot passed; QA tab closed.")
finally:
    if pid is not None:
        subprocess.run(["docker", "exec", cid, "kill", pid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
