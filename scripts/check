#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
docker compose config --quiet
docker compose up -d dev >/dev/null
docker compose exec -T dev sh -eu -c '
  test "$(id -u)" != 0
  ruby --version
  rails --version
  node --version
  opencode --version
  herdr --version
  tmux -V
  git --version
  python3 --version
  herdr integration status
  node /opt/browser/cdp.mjs status
  opencode debug skill > /tmp/opencode-skills.json
  jq -r ".paths[] | split(\"/\")[-1]" /opt/cleanroom/skills.lock.json |
    while IFS= read -r skill; do
      jq -e --arg skill "$skill" "any(.[]; .name == \$skill)" /tmp/opencode-skills.json >/dev/null
    done
  jq -r ".[].name" /tmp/opencode-skills.json | rg "^herdr$"
'
